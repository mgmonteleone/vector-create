{
  "name": "@vector-create/spa",
  "version": "0.1.0",
  "description": "Retro ASCII / terminal SPA for the vector-create generative studio.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src",
    "format": "biome format --write src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vector-create/core": "workspace:*",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@preact/preset-vite": "^2.9.1",
    "@testing-library/preact": "^3.2.4",
    "happy-dom": "^15.11.6",
    "typescript": "^5.6.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
