{
  "name": "@vector-create/server",
  "version": "0.1.0",
  "description": "One service, three faces — REST (Hono), gRPC (proto-first), and hosted MCP — over a shared operations layer atop @vector-create/core + @vector-create/agent.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "vector-create-server": "./dist/main.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "test": "bun test",
    "lint": "biome check src",
    "format": "biome format --write src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@hono/node-server": "^2.0.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@resvg/resvg-js": "^2.6.2",
    "@vector-create/agent": "workspace:*",
    "@vector-create/core": "workspace:*",
    "hono": "^4.12.29",
    "zod": "^4.4.3"
  }
}
