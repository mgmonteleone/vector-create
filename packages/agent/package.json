{
  "name": "@vector-create/agent",
  "version": "0.1.0",
  "description": "LLM agent that steers concept genomes from natural language and authors new concepts, wrapping the Cosmos Agent SDK with graceful fallback to core's deterministic promptMap.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "lint": "biome check src",
    "format": "biome format --write src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@augmentcode/cosmos-agent-sdk": "0.0.1-alpha.0",
    "@vector-create/core": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/bun": "^1.3.14",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0"
  }
}
